%%
%%  Opzioni del pacchetto (tutte facoltative):
%%    subject   = math | physics   materia predefinita       (math)
%%    plots     = true | false     carica pgfplots            (true)
%%    units     = true | false     carica siunitx             (true)
%%    seed      = <intero>         seme casuale; 0 = casuale  (1)
%%    answers                      copia docente: risposte corrette evidenziate
%%    nofigures                    bozza veloce: TikZ sostituito da riquadri
%%    cache                        memoize: le figure vengono ricompilate solo
%%                                 quando cambiano (prima compilazione lenta)
%%    legacy                       carica i vecchi comandi di fancylessons
%%
%%  Overleaf: usare TeX Live 2023 o successivo (Menu > Impostazioni).
%%  La chiave di correzione delle risposte multiple viene scritta in
%%  <nomefile>.key.csv (su Overleaf: "Log e file di output").
%%
%%  Indice
%%    1. Opzioni          6. Esercizi
%%    2. Pacchetti        7. Quesiti (parts)
%%    3. Colori e testo   8. Risposta multipla (choices)
%%    4. Punteggi         9. Casualita' (pick, randint, shuffle)
%%    5. Intestazione    10. Grafici, fisica, matematica, soluzioni
%%                       11. Livello di compatibilita' (legacy)
%% =========================================================================

\NeedsTeXFormat{LaTeX2e}[2022-11-01]
\ProvidesPackage{fancytests}[2026-10-09 v2.0 Verifiche di matematica e fisica]

