% --- 11.4 Opzioni a risposta multipla (vecchie macro -> motore choices) ------
%  Firma comune: {opz1}...{opzN}(stretch)<colonna>|rientro|'spazio dopo'
\ExplSyntaxOn
\cs_new_protected:Npn \__ft_legacy_opts:nnnnn #1#2#3#4#5
  { % #1 colonne, #2 mescola (true/false), #3 ultima fissa (true/false),
    % #4 {{opz}{opz}...}, #5 {rientro}{spazio}
    \tl_clear:N \l_tmpa_tl
    \int_zero:N \l_tmpa_int
    \tl_map_inline:nn {#4}
      {
        \int_incr:N \l_tmpa_int
        \bool_lazy_and:nnTF { \str_if_eq_p:nn {#3} { true } }
          { \int_compare_p:nNn \l_tmpa_int = { \tl_count:n {#4} } }
          { \tl_put_right:Nn \l_tmpa_tl { \choice [ fixed ] ##1 } }
          { \tl_put_right:Nn \l_tmpa_tl { \choice ##1 } }
      }
    \__ft_legacy_opts_aux:nnnnV {#1} {#2} #5 \l_tmpa_tl
  }
\cs_new_protected:Npn \__ft_legacy_opts_aux:nnnnn #1#2#3#4#5
  {
    \group_begin:
    \bool_set_true:N \l__ft_ch_openend_bool
    \__ft_choices:nn { cols = #1 , shuffle = #2 , indent = #3 , after = #4 em } {#5}
    \group_end:
  }
\cs_generate_variant:Nn \__ft_legacy_opts_aux:nnnnn { nnnnV }

\cs_new_protected:Npn \__ft_legacy_define:Nnnnn #1#2#3#4#5
  { % comando, numero opzioni, colonne, mescola, ultima fissa
    \int_case:nn {#2}
      {
        { 2 } { \NewDocumentCommand #1 { m m D(){1} D<>{X} D||{\itmindent} D''{.25} }
                  { \__ft_legacy_opts:nnnnn {#3} {#4} {#5} { {##1} {##2} } { {##5} {##6} } } }
        { 3 } { \NewDocumentCommand #1 { m m m D(){1} D<>{X} D||{\itmindent} D''{.25} }
                  { \__ft_legacy_opts:nnnnn {#3} {#4} {#5} { {##1} {##2} {##3} } { {##6} {##7} } } }
        { 4 } { \NewDocumentCommand #1 { m m m m D(){1} D<>{X} D||{\itmindent} D''{.25} }
                  { \__ft_legacy_opts:nnnnn {#3} {#4} {#5} { {##1} {##2} {##3} {##4} } { {##7} {##8} } } }
        { 5 } { \NewDocumentCommand #1 { m m m m m D(){1} D<>{X} D||{\itmindent} D''{.25} }
                  { \__ft_legacy_opts:nnnnn {#3} {#4} {#5} { {##1} {##2} {##3} {##4} {##5} } { {##8} {##9} } } }
      }
  }
