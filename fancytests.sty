\newif\ifft@timing   \ft@timingtrue
\newif\ifft@showversion
\newif\ifft@reduced
\def\ft@subject{}\def\ft@class{}\def\ft@date{}\def\ft@title{}
\def\ft@type{Verifica}\def\ft@dsa{none}\def\ft@recovery{}\def\ft@gradebox{VOTO}
\def\ft@labels{box}\def\ft@hstyle{full}\def\ft@tbreak{auto}

\ExplSyntaxOn
\bool_new:N \g__ft_shuffle_bool \bool_gset_true:N \g__ft_shuffle_bool
\keys_define:nn { fancytests / test }
  {
    subject     .code:n   = \__ft_set_subject:n {#1} ,
    materia     .code:n   = \__ft_set_subject:n {#1} ,
    class       .tl_set:N = \ft@class ,     classe   .tl_set:N = \ft@class ,
    date        .tl_set:N = \ft@date ,      data     .tl_set:N = \ft@date ,
    title       .tl_set:N = \ft@title ,     titolo   .tl_set:N = \ft@title ,
    type        .tl_set:N = \ft@type ,      tipo     .tl_set:N = \ft@type ,
    recovery    .tl_set:N = \ft@recovery ,  recupero .tl_set:N = \ft@recovery ,
    gradebox    .tl_set:N = \ft@gradebox ,  voto     .tl_set:N = \ft@gradebox ,
    dsa         .code:n = { \tl_if_blank:nTF {#1} { \def \ft@dsa {none} } { \def \ft@dsa {#1} } } ,
    timing      .legacy_if_set:n = ft@timing ,  orari .legacy_if_set:n = ft@timing ,
    showversion .legacy_if_set:n = ft@showversion ,
    showversion .default:n = true ,
    answers     .legacy_if_set:n = ft@answers ,
    answers     .default:n = true ,
    reduced     .legacy_if_set:n = ft@reduced ,
    reduced     .default:n = true ,
    style       .choices:nn = { full , compact }
                  { \tl_set_eq:NN \ft@hstyle \l_keys_choice_tl } ,
    titlebreak  .choices:nn = { auto , always , never }
                  { \tl_set_eq:NN \ft@tbreak \l_keys_choice_tl } ,
    labels      .choices:nn = { box , letters }
                  { \tl_set_eq:NN \ft@labels \l_keys_choice_tl } ,
    shuffle     .bool_gset:N = \g__ft_shuffle_bool ,
    decimal     .tl_gset:N = \g__ft_decimal_tl ,
    opacity     .tl_gset:N = \g__ft_opacity_tl ,
    grade-min   .tl_gset:N = \g__ft_grademin_tl ,
    grade-max   .tl_gset:N = \g__ft_grademax_tl ,
    autoclose   .bool_gset:N = \g__ft_autoclose_bool ,
    final       .tl_gset:N = \g__ft_finstyle_default_tl ,
    shuffleparts .bool_gset:N = \g__ft_shuffleparts_bool ,
    shuffleparts .default:n  = true ,
    seed        .code:n = { \tl_gset:Nn \ft@seed {#1} \setseed {#1} } ,
  }

\cs_new_protected:Npn \__ft_set_subject:n #1
  {
    \str_case_e:nnF { \str_lowercase:f {#1} }
      {
        { math }       { \def \ft@subject {Matematica} \xglobal \colorlet{SubjectColor}{MathsBlue} }
        { maths }      { \def \ft@subject {Matematica} \xglobal \colorlet{SubjectColor}{MathsBlue} }
        { matematica } { \def \ft@subject {Matematica} \xglobal \colorlet{SubjectColor}{MathsBlue} }
        { physics }    { \def \ft@subject {Fisica} \xglobal \colorlet{SubjectColor}{PhysicsGreen} }
        { phys }       { \def \ft@subject {Fisica} \xglobal \colorlet{SubjectColor}{PhysicsGreen} }
        { fisica }     { \def \ft@subject {Fisica} \xglobal \colorlet{SubjectColor}{PhysicsGreen} }
      }
      { \def \ft@subject {#1} }
  }
\__ft_set_subject:n { \ft@subjectopt }

\NewDocumentCommand \testsetup { m } { \keys_set:nn { fancytests / test } {#1} }

% bridge per il codice di impaginazione
\cs_new:Npn \ft@version { \int_use:N \g__ft_version_int }
\cs_new:Npn \ft@opacity { \g__ft_opacity_tl }
\cs_new_protected:Npn \ft@newtest
  {
    \__ft_autoclose:
    \__ft_reset_all:
    \int_gincr:N \g__ft_version_int
    \setcounter{ftpart}{0}
  }
\NewDocumentCommand \testheader { O{} }
  {
    \pagestyle{empty} \thispagestyle{empty}
    % colore della materia impostata con \testsetup (una materia data solo
    % all'intestazione precedente non deve restare attiva)
    \__ft_set_subject:n { \ft@subject }
    \group_begin:
    \keys_set:nn { fancytests / test } {#1}
    \ft@newtest
    \str_if_eq:VnTF \ft@hstyle { compact } { \ft@header@compact } { \ft@header@layout }
    \group_end:
  }
\ExplSyntaxOff

\newcommand*{\ft@blankdate}{%
  \textcolor{black!30}{\_\_}/\textcolor{black!30}{\_\_}/\textcolor{black!30}{\_\_\_\_}}

\newcommand*{\ft@dsabox}{%
  \def\ft@tmp{dsa}\ifx\ft@dsa\ft@tmp
    \scriptsize
    \begin{tabular}[t]{@{}c@{\hspace{.75em}}l@{}}
      $\square$ & Schemi e calcolatrice\\[-.1em]
      $\square$ & Riduzione es./tempo aggiuntivo\\[-.1em]
