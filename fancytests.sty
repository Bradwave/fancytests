% --- 10.1 Grafici di funzione (pgfplots) -------------------------------------
%  \begin{ftplot}[xmin=-5, xmax=5, ymin=-5, ymax=5, width=8cm, height=8cm]
%    \fplot{e^x - 1}[A]
%    \fplot[domain=1.001:5, dashed]{-ln(x-1)}[B]
%  \end{ftplot}
%  Stile `ft` = assi centrati, griglia principale e secondaria, curve nere
%  spesse; le curve successive cambiano stile (continua, tratteggiata, grigia,
%  punteggiata) e restano distinguibili in fotocopia.
\ifft@plots
\pgfplotsset{
  ft/.style={
    axis lines=middle, xlabel={$x$},
    grid=both, grid style={gray}, minor tick num=3, minor grid style={gray!30},
    legend pos=north west, legend cell align=left,
    restrict y to domain=-50:50,
    width=8cm, height=8cm,
    cycle list={
      {black, very thick},
      {black, very thick, dashed},
      {gray!80, very thick},
      {black, very thick, dotted}},
    every axis plot/.append style={samples=80, mark=none},
  },
}
\NewDocumentEnvironment{ftplot}{O{}}
  {\begin{tikzpicture}\begin{axis}[ft,#1]}
  {\end{axis}\end{tikzpicture}}
\NewDocumentCommand{\fplot}{O{} m o}{%
  \addplot+[#1]{#2};%
  \IfValueT{#3}{\addlegendentry{#3}}}
\fi

% --- 10.2 Diagrammi di fisica (TikZ) -----------------------------------------
\tikzset{
  force/.style     ={-{Stealth[length=2.5mm]}, very thick, FriendlyRed},
  velocity/.style  ={-{Stealth[length=2.5mm]}, very thick, FriendlyDenim},
  vector/.style    ={-{Stealth[length=2mm]}, thick},
  axis arrow/.style={-{Stealth[length=1.6mm]}},
  dimension/.style ={{Stealth[length=1.5mm]}-{Stealth[length=1.5mm]}, thin},
  body/.style      ={draw, thick, fill=black!6},
  ground/.style    ={fill=black!12, draw=none},
  spring/.style    ={decorate, decoration={coil, aspect=.4, segment length=1.6mm,
                     amplitude=1.6mm, pre length=2mm, post length=2mm}},
  % curve che "continuano" oltre il tratto disegnato (puntini alle estremita')
  continuation/.style={densely dotted},
