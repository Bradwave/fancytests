%% =========================================================================
%% 4. Motore dei punteggi
%% =========================================================================
%%  \score[short]{1.5}     punteggio di un quesito (stampa il riquadro)
%%  \invscore{1}           punteggio invisibile
%%  \exercisescore         chiude l'esercizio (somma automatica)
%%  \exercisescore[2]      ... con punteggio imposto  (o [pts=2, label=X])
%%  \finalscore[style=...] tabella / formula del voto

\ExplSyntaxOn

\fp_new:N  \g__ft_ex_fp        % esercizio corrente
\fp_new:N  \g__ft_total_fp     % totale (esclusi bonus)
\fp_new:N  \g__ft_bonus_fp     % bonus
\fp_new:N  \g__ft_saved_fp
\seq_new:N \g__ft_exscores_seq % punteggi E1, E2, ...
\int_new:N \g__ft_ex_int       % numero esercizio corrente
\int_new:N \g__ft_version_int  % numero della copia (1 per intestazione)
\bool_new:N \g__ft_ex_open_bool
\bool_new:N \g__ft_ex_bonus_bool
\bool_new:N \g__ft_inparts_bool
\tl_new:N  \l__ft_fmt_tl

\tl_new:N \g__ft_decimal_tl      \tl_gset:Nn \g__ft_decimal_tl {.}
\tl_new:N \g__ft_opacity_tl      \tl_gset:Nn \g__ft_opacity_tl {12}
\tl_new:N \g__ft_grademin_tl     \tl_gset:Nn \g__ft_grademin_tl {2}
\tl_new:N \g__ft_grademax_tl     \tl_gset:Nn \g__ft_grademax_tl {10}
\bool_new:N \g__ft_autoclose_bool \bool_gset_true:N \g__ft_autoclose_bool

% Formatta un numero: 1 -> 1,0   0.75 -> 0,75
\cs_new_protected:Npn \__ft_fmt:n #1
  {
    \tl_set:Nx \l__ft_fmt_tl { \fp_eval:n { round( #1 , 2 ) } }
    \tl_if_in:NnF \l__ft_fmt_tl { . } { \tl_put_right:Nn \l__ft_fmt_tl { .0 } }
    \tl_replace_once:NnV \l__ft_fmt_tl { . } \g__ft_decimal_tl
  }

% Riquadro colorato  "    /1,0"
\cs_new_protected:Npn \__ft_box:nn #1#2
  {
    \__ft_fmt:n {#2}
    \colorbox { SubjectColor ! \g__ft_opacity_tl }
      {
        \scriptsize \ttfamily
        \str_if_eq:eeTF {#1} { short } { \hspace{1.5em} } { \hspace{2em} }
        / \l__ft_fmt_tl
      }
  }
\NewDocumentCommand \scorebox { O{} m } { \__ft_box:nn {#1} {#2} }
\NewDocumentCommand \emptyscorebox { }
  { \colorbox { SubjectColor ! \g__ft_opacity_tl } { \scriptsize \ttfamily \hspace{2.9em} } }

\NewDocumentCommand \AddScore { m } { \fp_gadd:Nn \g__ft_ex_fp {#1} }
\NewDocumentCommand \SubScore { m } { \fp_gsub:Nn \g__ft_ex_fp {#1} }
\NewDocumentCommand \ResetScore { } { \fp_gzero:N \g__ft_ex_fp }
\NewDocumentCommand \DisplayScore { } { \fp_to_decimal:N \g__ft_ex_fp }
\NewDocumentCommand \DisplayTotal { } { \fp_to_decimal:N \g__ft_total_fp }
\NewDocumentCommand \SaveCurrentScore { } { \fp_gset_eq:NN \g__ft_saved_fp \g__ft_ex_fp }
\NewDocumentCommand \SetScoreToSaved { } { \fp_gset_eq:NN \g__ft_ex_fp \g__ft_saved_fp }

\NewDocumentCommand \score { O{} m } { \fp_gadd:Nn \g__ft_ex_fp {#2} \__ft_box:nn {#1} {#2} }
\NewDocumentCommand \invscore { m } { \fp_gadd:Nn \g__ft_ex_fp {#1} }

% --- chiusura esercizio -----------------------------------------------------
\keys_define:nn { fancytests / exscore }
  {
    pts   .tl_set:N = \l__ft_exs_pts_tl ,
    label .tl_set:N = \l__ft_exs_label_tl ,
    short .bool_set:N = \l__ft_exs_short_bool ,
  }

\cs_new_protected:Npn \__ft_exscore:n #1
  {
    \tl_clear:N \l__ft_exs_pts_tl
    \tl_clear:N \l__ft_exs_label_tl
    \bool_set_false:N \l__ft_exs_short_bool
    \tl_if_blank:nF {#1}
      {
        \tl_if_in:nnTF {#1} { = }
          { \keys_set:nn { fancytests / exscore } {#1} }
          { \tl_set:Nn \l__ft_exs_pts_tl {#1} }      % sintassi vecchia: [2.0]
      }
    \tl_if_empty:NT \l__ft_exs_pts_tl
      { \tl_set:Nx \l__ft_exs_pts_tl { \fp_to_decimal:N \g__ft_ex_fp } }
    \bool_if:NTF \g__ft_ex_bonus_bool
      {
        \fp_gadd:Nn \g__ft_bonus_fp { \l__ft_exs_pts_tl }
        \tl_if_empty:NT \l__ft_exs_label_tl { \tl_set:Nn \l__ft_exs_label_tl { EB } }
      }
      {
        \fp_gadd:Nn \g__ft_total_fp { \l__ft_exs_pts_tl }
        \seq_gput_right:Nx \g__ft_exscores_seq { \fp_eval:n { \l__ft_exs_pts_tl } }
        \tl_if_empty:NT \l__ft_exs_label_tl
          { \tl_set:Nx \l__ft_exs_label_tl { E \int_use:N \g__ft_ex_int } }
      }
    \par \nobreak \noindent \hfill
    { \small \bfseries \l__ft_exs_label_tl {:} } ~
    \__ft_box:nn { \bool_if:NT \l__ft_exs_short_bool { short } } { \l__ft_exs_pts_tl }
    \par
    \fp_gzero:N \g__ft_ex_fp
    \bool_gset_false:N \g__ft_ex_open_bool
    \bool_gset_false:N \g__ft_ex_bonus_bool
  }
\NewDocumentCommand \exercisescore { O{} } { \__ft_exscore:n {#1} }
\NewDocumentCommand \bonusexercisescore { O{} }
  { \bool_gset_true:N \g__ft_ex_bonus_bool \__ft_exscore:n {#1} }

% chiusura automatica di un esercizio dimenticato aperto
\cs_new_protected:Npn \__ft_autoclose:
  {
    \bool_if:nT { \g__ft_ex_open_bool && \g__ft_autoclose_bool }
      { \__ft_exscore:n { } }
  }

\cs_new_protected:Npn \__ft_reset_all:
  {
    \seq_gclear:N \g__ft_exscores_seq
    \fp_gzero:N \g__ft_ex_fp
    \fp_gzero:N \g__ft_total_fp
    \fp_gzero:N \g__ft_bonus_fp
    \int_gzero:N \g__ft_ex_int
    \bool_gset_false:N \g__ft_ex_open_bool
    \bool_gset_false:N \g__ft_ex_bonus_bool
  }
\NewDocumentCommand \ResetAllScores { } { \__ft_reset_all: }

% --- voto finale ------------------------------------------------------------
\keys_define:nn { fancytests / final }
  {
    style .choices:nn = { table , compact , formula , minimal , none }
                        { \tl_set_eq:NN \l__ft_fin_style_tl \l_keys_choice_tl } ,
    max   .tl_set:N   = \l__ft_fin_max_tl ,
    bonus .choices:nn = { auto , true , false }
                        { \tl_set_eq:NN \l__ft_fin_bonus_tl \l_keys_choice_tl } ,
    label .tl_set:N   = \l__ft_fin_label_tl ,
  }
\tl_new:N \l__ft_fin_style_tl
\tl_new:N \l__ft_fin_bonus_tl
\tl_new:N \g__ft_finstyle_default_tl \tl_gset:Nn \g__ft_finstyle_default_tl { compact }
\tl_new:N \l__ft_tab_spec_tl
\tl_new:N \l__ft_tab_head_tl
\tl_new:N \l__ft_tab_body_tl
\int_new:N \l__ft_tab_int

\cs_new:Npn \__ft_max_tl:
  { \tl_if_empty:NTF \l__ft_fin_max_tl { \fp_to_decimal:N \g__ft_total_fp } { \l__ft_fin_max_tl } }

\cs_new_protected:Npn \__ft_formula:
  {
    \__ft_fmt:n { \__ft_max_tl: }
    $ \textrm{voto} = \dfrac{\textrm{punti~ottenuti}}{\textrm{punti~massimi}}
      \cdot \fp_eval:n { \g__ft_grademax_tl - \g__ft_grademin_tl } + \g__ft_grademin_tl
      = \dfrac{\hspace{1.5em}}{\l__ft_fmt_tl}
      \cdot \fp_eval:n { \g__ft_grademax_tl - \g__ft_grademin_tl } + \g__ft_grademin_tl
      = \qquad\quad $
  }

\cs_new_protected:Npn \__ft_final_table:
  {
    \tl_clear:N \l__ft_tab_spec_tl
    \tl_clear:N \l__ft_tab_head_tl
    \tl_clear:N \l__ft_tab_body_tl
    \int_zero:N \l__ft_tab_int
    \seq_map_inline:Nn \g__ft_exscores_seq
      {
        \int_incr:N \l__ft_tab_int
        \int_compare:nNnF \l__ft_tab_int = 1
          {
            \tl_put_right:Nn \l__ft_tab_spec_tl { | }
            \tl_put_right:Nn \l__ft_tab_head_tl { & }
            \tl_put_right:Nn \l__ft_tab_body_tl { & }
          }
        \tl_put_right:Nn \l__ft_tab_spec_tl { c }
        \tl_put_right:Nx \l__ft_tab_head_tl { \exp_not:N \textbf { E \int_use:N \l__ft_tab_int } }
        \tl_put_right:Nn \l__ft_tab_body_tl { \scorebox {##1} }
      }
    \bool_if:nT
      {
        \str_if_eq_p:Vn \l__ft_fin_bonus_tl { true } ||
        ( \str_if_eq_p:Vn \l__ft_fin_bonus_tl { auto } &&
          \fp_compare_p:nNn \g__ft_bonus_fp > 0 )
      }
      {
        \tl_put_right:Nn  \l__ft_tab_spec_tl { | c }
        \tl_put_right:Nn  \l__ft_tab_head_tl { & \textbf{EB} }
        \tl_put_right:Nx  \l__ft_tab_body_tl
          { & \exp_not:N \scorebox { \fp_to_decimal:N \g__ft_bonus_fp } }
      }
    \tl_put_right:Nn \l__ft_tab_spec_tl { | c }
    \tl_put_right:Nn \l__ft_tab_head_tl { & \textbf{Tot.} }
    \tl_put_right:Nx \l__ft_tab_body_tl { & \exp_not:N \scorebox { \__ft_max_tl: } }
    \use:x
      {
        \exp_not:N \begin{tabular} { \exp_not:V \l__ft_tab_spec_tl }
          \exp_not:V \l__ft_tab_head_tl \exp_not:N \\ \exp_not:N \hline
          \exp_not:V \l__ft_tab_body_tl
        \exp_not:N \end{tabular}
      }
  }

\NewDocumentCommand \finalscore { O{} }
  {
    \__ft_autoclose:
    \tl_set_eq:NN \l__ft_fin_style_tl \g__ft_finstyle_default_tl
    \tl_set:Nn \l__ft_fin_bonus_tl { auto }
    \tl_clear:N \l__ft_fin_max_tl
    \tl_set:Nn \l__ft_fin_label_tl { Tot: }
    \keys_set:nn { fancytests / final } {#1}
    \par
    \str_case:Vn \l__ft_fin_style_tl
      {
        { table }
          {
            \begin{center}
              \__ft_final_table: \par \medskip
              \__ft_formula:
            \end{center}
          }
        { compact }
          {
            \noindent
            \makebox[\linewidth]
              {
                \hfill \colorbox { SubjectColor ! \g__ft_opacity_tl } { \__ft_formula: }
                \hfill \llap { \textbf { \l__ft_fin_label_tl } ~ \scorebox { \__ft_max_tl: } }
              }
          }
        { formula }
          {
            \begin{center}
              \colorbox { SubjectColor ! \g__ft_opacity_tl } { \__ft_formula: }
            \end{center}
          }
        { minimal }
          { \noindent \hfill \textbf { \l__ft_fin_label_tl } ~ \scorebox { \__ft_max_tl: } }
        { none } { }
      }
    \par
    \__ft_reset_all:
  }

% Punteggio totale corrente (es. per scriverlo nel testo)
\NewDocumentCommand \currenttotal { } { \__ft_fmt:n { \g__ft_total_fp } \l__ft_fmt_tl }

\ExplSyntaxOff

