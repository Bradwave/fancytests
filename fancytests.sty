      { \setcounter{ftpart}{ \int_eval:n { \l__ft_parts_start_int - 1 } } }
    \dim_set:Nn \l__ft_parts_sep_dim
      { \fp_to_dim:n { ( \l__ft_parts_stretch_fp - 1 ) * \baselineskip } }
    \bool_gset_true:N \g__ft_inparts_bool
    \cs_set_eq:NN \itemx \__ft_itemx_cmd
    \int_compare:nNnTF \l__ft_parts_cols_int > 1
      {
        \setlength \ft@cellw
          { \dim_eval:n { ( \linewidth - \ft@colgap * ( \l__ft_parts_cols_int - 1 ) )
                          / \l__ft_parts_cols_int - 1pt } }
        \par \addvspace { \dim_eval:n { \l__ft_parts_sep_dim / 2 + 2pt } }
        \lineskip = \dim_eval:n { \l__ft_parts_sep_dim + 2pt } \relax
        \lineskiplimit = 0pt \relax
        \noindent
      }
      { \__ft_list_begin: }
    \bool_if:NTF \l__ft_parts_shuffle_bool
      {
        \__ft_shuffle_body:Nnn \l__ft_shuf_out_tl { \itemx } {#2}
        \tl_use:N \l__ft_shuf_out_tl
      }
      { \ignorespaces #2 }
  }
  {
    \__ft_close_skip:
    \int_compare:nNnTF \l__ft_parts_cols_int > 1
      {
        \bool_if:NF \l__ft_parts_first_bool { \endlist \end{minipage} \hss \egroup }
        \par \addvspace { \dim_eval:n { \l__ft_parts_sep_dim / 2 + 2pt } }
      }
      { \endlist }
    % la scatola che contiene l'elenco occupa tutta la larghezza
    % (serve dentro le minipage, dove i punteggi stanno nel margine destro)
    \par \nointerlineskip \hbox_to_wd:nn { \l__ft_parts_outer_dim } { }
    \bool_gset_false:N \g__ft_inparts_bool
  }
\NewDocumentCommand \__ft_itemx_cmd { O{} } { \__ft_itemx:n {#1} }
\ExplSyntaxOff

%% =========================================================================
%% 8. Risposta multipla: ambiente choices
%% =========================================================================
%%  \begin{choices}[cols=auto]      auto | 1 | 2 | 3 | 4
%%    \correct  risposta giusta
%%    \choice   distrattore
%%    \choice[fixed] Nessuna delle precedenti     (resta in ultima posizione)
%%    \correct[if={v=2}] giusta solo se \pick[v]{..} ha scelto la 2a variante
%%  \end{choices}
%%  Chiavi: cols, shuffle=true|false, indent=<dim>, labels=box|letters,
%%          before=<dim> (spazio sopra, 2pt), rowsep=<dim> (spazio extra tra
%%          le righe, 0pt), after=<dim> (spazio sotto, .25em).
%%  Le opzioni vengono mescolate (seme fisso: copie riproducibili) e la
%%  chiave di correzione e' scritta in <nomefile>.key.csv.
%%  Con l'opzione `answers` la risposta corretta e' evidenziata.

\ExplSyntaxOn
\tl_new:N  \l__ft_ch_cols_tl
\bool_new:N \l__ft_ch_shuffle_bool
\dim_new:N \l__ft_ch_indent_dim
\tl_new:N  \l__ft_ch_labels_tl
\dim_new:N \l__ft_ch_after_dim
\dim_new:N \l__ft_ch_before_dim
\dim_new:N \l__ft_ch_rowsep_dim
\keys_define:nn { fancytests / choices }
  {
    cols    .tl_set:N   = \l__ft_ch_cols_tl ,
    shuffle .bool_set:N = \l__ft_ch_shuffle_bool ,
    indent  .dim_set:N  = \l__ft_ch_indent_dim ,
    labels  .tl_set:N   = \l__ft_ch_labels_tl ,
    after   .dim_set:N  = \l__ft_ch_after_dim ,
    before  .dim_set:N  = \l__ft_ch_before_dim ,
    rowsep  .dim_set:N  = \l__ft_ch_rowsep_dim ,
    ragged  .code:n     = { } ,
  }
\keys_define:nn { fancytests / choice }
  {
    fixed .bool_set:N = \l__ft_c_fixed_bool ,
    fixed .default:n  = true ,
    if    .tl_set:N   = \l__ft_c_if_tl ,
  }

\seq_new:N \l__ft_ch_raw_seq
\seq_new:N \l__ft_ch_text_seq
\seq_new:N \l__ft_ch_fixed_seq
\seq_new:N \l__ft_ch_correct_seq
\seq_new:N \l__ft_ch_pool_seq
\seq_new:N \l__ft_ch_order_seq
\tl_new:N  \l__ft_ch_body_tl
\tl_new:N  \l__ft_ch_item_tl
\tl_new:N  \l__ft_ch_key_tl
\int_new:N \l__ft_ch_n_int
\int_new:N \l__ft_ch_cols_int
\int_new:N \l__ft_ch_k_int
