% --- mescolamento generico di un corpo diviso da un comando ------------------
%  #1 risultato, #2 comando separatore (\itemx o \exercise), #3 corpo.
%  Ogni pezzo inizia con il separatore; le chiavi fixed/follow nelle sue
%  opzioni lo tengono fermo o lo legano al pezzo precedente.
\bool_new:N \l__ft_sm_fixed_bool
\bool_new:N \l__ft_sm_follow_bool
\keys_define:nn { fancytests / shufmeta }
  {
    fixed  .bool_set:N = \l__ft_sm_fixed_bool ,
    fixed  .default:n  = true ,
    follow .bool_set:N = \l__ft_sm_follow_bool ,
    follow .default:n  = true ,
  }
\seq_new:N \l__ft_sb_raw_seq
\seq_new:N \l__ft_sb_blocks_seq
\seq_new:N \l__ft_sb_fixed_seq
\seq_new:N \l__ft_sb_pool_seq
\tl_new:N  \l__ft_sb_piece_tl
\tl_new:N  \l__ft_sb_block_tl
\cs_new_protected:Npn \__ft_sb_opts:w [ #1 ] #2 \q_stop
  { \keys_set_known:nn { fancytests / shufmeta } {#1} }
\cs_new_protected:Npn \__ft_shuffle_body:Nnn #1#2#3
  {
    \seq_set_split_keep_spaces:Nnn \l__ft_sb_raw_seq {#2} {#3}
    \seq_pop_left:NN \l__ft_sb_raw_seq #1          % testo prima del primo pezzo
    \seq_clear:N \l__ft_sb_blocks_seq
    \seq_clear:N \l__ft_sb_fixed_seq
    \seq_map_inline:Nn \l__ft_sb_raw_seq
      {
        \bool_set_false:N \l__ft_sm_fixed_bool
        \bool_set_false:N \l__ft_sm_follow_bool
        \tl_set:Nn \l__ft_sb_piece_tl {##1}
        \tl_trim_spaces:N \l__ft_sb_piece_tl
        \exp_args:NV \tl_if_head_eq_charcode:nNT \l__ft_sb_piece_tl [
          { \exp_last_unbraced:NV \__ft_sb_opts:w \l__ft_sb_piece_tl \q_stop }
        \bool_lazy_and:nnTF
          { \l__ft_sm_follow_bool }
          { ! \seq_if_empty_p:N \l__ft_sb_blocks_seq }
          {
            \seq_pop_right:NN \l__ft_sb_blocks_seq \l__ft_sb_block_tl
            \tl_put_right:Nn \l__ft_sb_block_tl { #2 ##1 }
            \seq_put_right:NV \l__ft_sb_blocks_seq \l__ft_sb_block_tl
          }
          {
            \seq_put_right:Nn \l__ft_sb_blocks_seq { #2 ##1 }
            \seq_put_right:Nx \l__ft_sb_fixed_seq { \bool_to_str:N \l__ft_sm_fixed_bool }
          }
      }
    \seq_clear:N \l__ft_sb_pool_seq
    \int_step_inline:nn { \seq_count:N \l__ft_sb_blocks_seq }
      {
        \str_if_eq:eeF { \seq_item:Nn \l__ft_sb_fixed_seq {##1} } { true }
          { \seq_put_right:Nn \l__ft_sb_pool_seq {##1} }
      }
    \seq_shuffle:N \l__ft_sb_pool_seq
    \int_step_inline:nn { \seq_count:N \l__ft_sb_blocks_seq }
      {
        \str_if_eq:eeTF { \seq_item:Nn \l__ft_sb_fixed_seq {##1} } { true }
          { \tl_put_right:Nx #1 { \exp_not:e { \seq_item:Nn \l__ft_sb_blocks_seq {##1} } } }
          {
            \seq_pop_left:NN \l__ft_sb_pool_seq \l_tmpa_tl
            \tl_put_right:Nx #1
              { \exp_not:e { \seq_item:Nn \l__ft_sb_blocks_seq { \l_tmpa_tl } } }
          }
      }
  }

