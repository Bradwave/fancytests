  }
\cs_new_protected:Npn \__ft_sl_begin:nnnn #1#2#3#4
  { % chiavi/inizio, (stretch), <colonna>, 'allineamento'
    \tl_set:Nn \l__ft_sl_stretch_tl { 1 }
    \tl_set:Nn \l__ft_sl_col_tl { H }
    \tl_set:Nn \l__ft_sl_align_tl { c }
    \int_zero:N \l__ft_sl_start_int
    \IfValueT {#2} { \tl_set:Nn \l__ft_sl_stretch_tl {#2} }
    \IfValueT {#3} { \tl_set:Nn \l__ft_sl_col_tl {#3} }
    \IfValueT {#4} { \tl_set:Nn \l__ft_sl_align_tl {#4} }
    \tl_if_blank:nF {#1}
      {
        \tl_if_in:nnTF {#1} { = }
          { \keys_set:nn { fancytests / scoredlist } {#1} }
          { \setcounter{ftpart}{#1} }
      }
    \int_compare:nNnT \l__ft_sl_start_int > 0
      { \setcounter{ftpart}{ \int_eval:n { \l__ft_sl_start_int - 1 } } }
    \cs_set_eq:NN \itemx \ft@legacyitemx
    \renewcommand{\arraystretch}{ \l__ft_sl_stretch_tl }
  }
