\def\prunelist#1{%
  \expandafter\edef\csname pgfmath@randomlist@#1\endcsname
    {\the\numexpr\csname pgfmath@randomlist@#1\endcsname-1\relax}%
  \count@\pgfmath@randomtemp
  \loop
    \expandafter\let
    \csname pgfmath@randomlist@#1@\the\count@\expandafter\endcsname
