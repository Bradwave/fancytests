\ExplSyntaxOn
\tl_new:N \l__ft_ex_title_tl
\tl_new:N \l__ft_ex_diff_tl
\bool_new:N \l__ft_ex_bonus_bool
\keys_define:nn { fancytests / exercise }
  {
    title .tl_set:N   = \l__ft_ex_title_tl ,
    diff  .tl_set:N   = \l__ft_ex_diff_tl ,
    bonus .bool_set:N = \l__ft_ex_bonus_bool ,
    bonus .default:n  = true ,
    fixed  .code:n    = { } ,   % usate solo da exercises
    follow .code:n    = { } ,
  }

\NewDocumentCommand \exercise { O{} }
  {
    \__ft_autoclose:
    \tl_clear:N \l__ft_ex_title_tl
    \tl_clear:N \l__ft_ex_diff_tl
    \bool_set_false:N \l__ft_ex_bonus_bool
    \tl_if_blank:nF {#1}
      {
        \bool_set_false:N \l_tmpa_bool
        \tl_if_in:nnT {#1} { = } { \bool_set_true:N \l_tmpa_bool }
        \tl_if_in:nnT {#1} { , } { \bool_set_true:N \l_tmpa_bool }
        \str_case:nnT {#1} { { bonus } { } { fixed } { } { follow } { } }
          { \bool_set_true:N \l_tmpa_bool }
        \bool_if:NTF \l_tmpa_bool
          { \keys_set:nn { fancytests / exercise } {#1} }
          { \tl_set:Nn \l__ft_ex_title_tl {#1} }        % \exercise[Titolo]
      }
    \bool_gset_true:N \g__ft_ex_open_bool
    \bool_gset_eq:NN \g__ft_ex_bonus_bool \l__ft_ex_bonus_bool
    \bool_if:NF \l__ft_ex_bonus_bool { \int_gincr:N \g__ft_ex_int }
    \setcounter{ftpart}{0}
    \fp_gzero:N \g__ft_ex_fp
    \par \addvspace { 3.25ex plus 1ex minus .2ex }
    \noindent
    {
      \bfseries
      \tl_if_empty:NF \l__ft_ex_diff_tl
        { \ft@diffmarks { \l__ft_ex_diff_tl } \hspace{.25em} }
      \tl_if_empty:NTF \l__ft_ex_title_tl
        {
          \bool_if:NTF \l__ft_ex_bonus_bool
            { Esercizio~Bonus \, * }
            { Esercizio ~ \int_use:N \g__ft_ex_int }
        }
        { \l__ft_ex_title_tl }
    }
    \hspace{1em} \ignorespaces
  }
\ExplSyntaxOff

\newcommand*{\bonusexercise}{\exercise[bonus]}
\newcommand*{\bonusexercisenote}{%
  {\footnotesize *\,L'esercizio bonus non è obbligatorio e non è necessario
   svolgerlo per raggiungere il voto massimo.\par}}

%% =========================================================================
%% 7. Quesiti: ambiente parts
%% =========================================================================
%%  \begin{parts}[stretch=1.5, cols=2, start=3, ragged]
%%    \itemx[pts=1] Testo del quesito...
%%    \itemx[pts=0.5, diff=2, mark] ...
%%    \itemx[pts=1, noreduced] ...   (omesso nella versione ridotta)
%%  \end{parts}
%%  Le lettere proseguono tra piu' ambienti parts dello stesso esercizio.
%%
%%  Mescolamento (facoltativo, spento di default):
%%    \begin{parts}[shuffle]  oppure  \testsetup{shuffleparts}  per tutta la verifica
%%    \itemx[fixed]   resta al suo posto (posto contato tra i blocchi)
%%    \itemx[follow]  si sposta insieme al quesito precedente
%%  Le lettere sono assegnate dopo il mescolamento; punteggi e chiave seguono.
%%  Limiti: i quesiti non devono citarsi per lettera; niente parts annidati.
%%  Il punteggio compare a destra della prima riga del quesito.

