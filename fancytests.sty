% riquadro del punteggio nel margine destro, alla prima riga del quesito
\cs_new_protected:Npn \__ft_put_score:n #1
  {
    \dim_set:Nn \l_tmpa_dim { \linewidth + \rightmargin }
    \hbox_set:Nn \l_tmpa_box { \__ft_box:nn { } {#1} }
    \dim_sub:Nn \l_tmpa_dim { \box_wd:N \l_tmpa_box }
    \leavevmode
    \hbox_overlap_right:n { \tex_kern:D \l_tmpa_dim \box_use:N \l_tmpa_box }
    \ignorespaces
  }

\cs_new_protected:Npn \__ft_close_skip:
  {
    \bool_if:NT \l__ft_skip_open_bool
      {
        \par \egroup    % chiude la \vbox di scarto
        \fp_gset_eq:NN \g__ft_ex_fp \l__ft_skip_saved_fp
        \setcounter{ftpart}{ \l__ft_skip_counter_int }
        \bool_set_false:N \l__ft_skip_open_bool
      }
  }

\cs_new_protected:Npn \__ft_close_cell:
  {
    \int_compare:nNnT \l__ft_parts_cols_int > 1
      {
        \bool_if:NF \l__ft_parts_first_bool
          {
            \endlist \end{minipage} \hss \egroup
            \int_compare:nNnTF { \int_mod:nn { \l__ft_parts_cell_int } { \l__ft_parts_cols_int } } = 0
              { \par \noindent }
              { \nobreak \hspace { \ft@colgap } }
          }
      }
  }

\cs_new_protected:Npn \__ft_itemx:n #1
  {
    \__ft_close_skip:      % prima di leggere le chiavi: \egroup ripristina i valori locali
    \tl_clear:N \l__ft_it_pts_tl
    \tl_clear:N \l__ft_it_diff_tl
    \bool_set_false:N \l__ft_it_mark_bool
    \bool_set_false:N \l__ft_it_upper_bool
    \bool_set_false:N \l__ft_it_noreduced_bool
    \keys_set:nn { fancytests / item } {#1}
    \bool_if:nTF { \l__ft_it_noreduced_bool && \legacy_if_p:n { ft@reduced } }
      {
        % quesito omesso nella versione ridotta: composto e scartato
        \fp_gset_eq:NN \l__ft_skip_saved_fp \g__ft_ex_fp
        \int_set:Nn \l__ft_skip_counter_int { \value{ftpart} }
        \bool_set_true:N \l__ft_skip_open_bool
        \setbox \ft@trashbox \vbox \bgroup \hsize = \linewidth
      }
      {
        \__ft_close_cell:
        \int_compare:nNnT \l__ft_parts_cols_int > 1
          {
            \int_incr:N \l__ft_parts_cell_int
            \hbox to \ft@cellw \bgroup
            \begin{minipage}[t]{\ft@cellw}
            \__ft_list_begin:
          }
        \bool_set_false:N \l__ft_parts_first_bool
        \stepcounter{ftpart}
        \item [ \__ft_label: ]
        \tl_if_empty:NF \l__ft_it_pts_tl
          {
            \fp_gadd:Nn \g__ft_ex_fp { \l__ft_it_pts_tl }
            \__ft_put_score:n { \l__ft_it_pts_tl }
          }
      }
  }

\cs_new_protected:Npn \__ft_label:
