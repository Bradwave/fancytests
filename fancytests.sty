%% =========================================================================
%% 9. Casualita'
%% =========================================================================
%%  \pick{a \or b \or c}          una variante a caso
%%  \pick[v]{a \or b}             ... ricordata col nome v (per \correct[if={v=2}])
%%  \randint[n]{1}{9}             intero casuale, ricordato col nome n
%%  \useval{n}                    ristampa il valore di n
%%  \begin{shuffle}[g] \block{..} \block{..} \end{shuffle}
%%  \shuffled{g}{1}               primo blocco dopo il mescolamento
%%  \begin{exercises} \exercise ... \exercise[fixed] ... \exercise[follow] ...
%%  \end{exercises}               mescola gli esercizi (numerati dopo)
%%
%%  Il seme e' fisso: ricompilando si ottengono le stesse copie.
%%    \usepackage[seed=42]{fancytests}   seme dell'intero documento (1 di default)
%%    \testsetup{seed=42}                idem, oppure da quel punto in poi
%%    \setseed{42}                       riparte da 42 da qui in avanti
%%    seed=0                             seme diverso a ogni compilazione

\ExplSyntaxOn
\seq_new:N \l__ft_pick_seq
\NewDocumentCommand \pick { O{last} m }
  {
    \seq_set_split:Nnn \l__ft_pick_seq { \or } {#2}
    \int_if_exist:cF { g__ft_pick_ #1 _int } { \int_new:c { g__ft_pick_ #1 _int } }
    \int_gset:cn { g__ft_pick_ #1 _int } { \int_rand:n { \seq_count:N \l__ft_pick_seq } }
    \seq_item:Nn \l__ft_pick_seq { \int_use:c { g__ft_pick_ #1 _int } }
  }
\NewDocumentCommand \randint { O{last} m m }
  {
    \int_if_exist:cF { g__ft_val_ #1 _int } { \int_new:c { g__ft_val_ #1 _int } }
    \int_gset:cn { g__ft_val_ #1 _int } { \int_rand:nn {#2} {#3} }
    \int_use:c { g__ft_val_ #1 _int }
  }
\NewDocumentCommand \useval { m } { \int_use:c { g__ft_val_ #1 _int } }

\seq_new:N \l__ft_shuffle_seq
\NewDocumentEnvironment { shuffle } { O{last} +b }
  {
    \seq_clear:N \l__ft_shuffle_seq
    \group_begin:
      \cs_set:Npn \block ##1 { \seq_put_right:Nn \l__ft_shuffle_seq {##1} }
      #2
      \seq_shuffle:N \l__ft_shuffle_seq
      \seq_if_exist:cF { g__ft_shuffle_ #1 _seq } { \seq_new:c { g__ft_shuffle_ #1 _seq } }
      \seq_gset_eq:cN { g__ft_shuffle_ #1 _seq } \l__ft_shuffle_seq
    \group_end:
  }
  { }
\NewExpandableDocumentCommand \shuffled { m m } { \seq_item:cn { g__ft_shuffle_ #1 _seq } {#2} }

% \setseed{n}: riparte da un seme preciso (da qui in avanti)
\NewDocumentCommand \setseed { m }
  { \sys_gset_rand_seed:n {#1} \pgfmathsetseed {#1} }
% seme casuale: uguale per l3 e pgf
\AddToHook { begindocument }
  {
    \int_compare:nNnF { \ft@seed } = 0
      {
        \sys_gset_rand_seed:n { \ft@seed }
        \pgfmathsetseed { \ft@seed }
      }
  }
