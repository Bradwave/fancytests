% impostazioni della lista interna
\cs_new_protected:Npn \__ft_list_begin:
  {
    \list { }
      {
        \setlength \leftmargin { \dim_eval:n { \itmindent + \ft@labelw + \ft@labelsep } }
        \setlength \labelwidth { \ft@labelw }
        \setlength \labelsep   { \ft@labelsep }
        \setlength \rightmargin { \ft@scorecol }
        \setlength \itemsep { \l__ft_parts_sep_dim }
        \setlength \parsep { 0pt }
        \setlength \topsep { \dim_eval:n { \l__ft_parts_sep_dim / 2 + 2pt } }
        \setlength \partopsep { 0pt }
