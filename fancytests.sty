\newcommand*{\ft@header@compact}{%
  \par\noindent
  \begin{minipage}[c]{\dimexpr\textwidth-5.5em\relax}
    % riga 1: titolo (va a capo se lungo), classe e data allineate a destra
    \sbox\ft@hbox{\textbf{Classe \ft@class}%
      \ifft@showversion\ {\color{black!40}\footnotesize\#\ft@version}\fi
      \ft@sqsep
      \ifx\ft@date\@empty\ft@blankdate\else\ft@date\fi}%
    % titolo: sulla stessa riga se ci sta, altrimenti su una riga propria
    \sbox\ft@tbox{{\Large\bfseries \ft@type\ di \ft@subject}%
      \ifx\ft@title\@empty\else\quad{\large \ft@title}\fi}%
    \ft@titlebreakfalse
    \ifx\ft@title\@empty\else
      \def\ft@tmp{always}\ifx\ft@tbreak\ft@tmp\ft@titlebreaktrue\fi
      \def\ft@tmp{auto}\ifx\ft@tbreak\ft@tmp
        \ifdim\wd\ft@tbox>\dimexpr\linewidth-\wd\ft@hbox-1.5em\relax
          \ft@titlebreaktrue\fi
      \fi
    \fi
    \ifft@titlebreak
      {\Large\bfseries \ft@type\ di \ft@subject}\hfill\usebox\ft@hbox
      \par\vspace{.1em}%
      {\raggedright\large \ft@title\par}%
    \else
      \parbox[b]{\dimexpr\linewidth-\wd\ft@hbox-1.5em\relax}{\raggedright
        {\Large\bfseries \ft@type\ di \ft@subject}%
        \ifx\ft@title\@empty\else\quad{\large \ft@title}\fi}%
      \hfill\usebox\ft@hbox
    \fi
    \par\vspace{.55em}%
    % riga 2: nome e orari
    % la riga del nome si allunga fino agli orari
    Nome e cognome: \leaders\hbox to 5pt{\hss.\hss}\hfill
    \ifft@timing
      \ft@sqsep\mbox{Inizio: \dotline{3em}$\,\rightarrow\,$Fine: \dotline{3em}%
      \ft@sqsep Consegna: \dotline{3em}}%
    \else
      \kern0pt % impedisce che i puntini vengano eliminati a fine riga
    \fi
    % riga 3 (facoltativa): misure DSA e recupero
    \def\ft@tmp{none}%
    \ifx\ft@dsa\ft@tmp
      \ifx\ft@recovery\@empty\else\par\vspace{.3em}\hfill{\footnotesize recupero del \ft@recovery}\fi
    \else
      \par\vspace{.3em}{\scriptsize\ft@dsainline}%
      \ifx\ft@recovery\@empty\else\hfill{\footnotesize recupero del \ft@recovery}\fi
    \fi
  \end{minipage}%
  \hfill
  \begin{tabular}[c]{|@{\,}c@{\,}|}
    \hline \makebox[3.6em]{\small\bfseries\ft@gradebox}\\ \hline
    \rule{0pt}{2.6em}\\ \hline
  \end{tabular}%
  % filetto di chiusura
  \par\vspace{.55em}\noindent
  {\color{black!45}\rule{\textwidth}{.4pt}}%
  \par\vspace{.7em}}

