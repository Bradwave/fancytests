\newif\ifft@legacy
\def\ft@seed{1}
\def\ft@subjectopt{math}

\ExplSyntaxOn
\keys_define:nn { fancytests / options }
  {
    plots     .legacy_if_gset:n = ft@plots ,
    units     .legacy_if_gset:n = ft@units ,
    cache     .legacy_if_gset:n = ft@cache ,
    nofigures .legacy_if_gset:n = ft@nofig ,
    answers   .legacy_if_gset:n = ft@answers ,
    legacy    .legacy_if_gset:n = ft@legacy ,
    plots     .default:n = true ,
    units     .default:n = true ,
    cache     .default:n = true ,
    nofigures .default:n = true ,
    answers   .default:n = true ,
    legacy    .default:n = true ,
    seed      .tl_gset:N = \ft@seed ,
    subject   .tl_gset:N = \ft@subjectopt ,
  }
\ExplSyntaxOff
\ProcessKeyOptions[fancytests/options]

