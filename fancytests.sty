\box_new:N \l__ft_ch_tmp_box

\cs_new:Npn \__ft_correct_mark: { }

% chiave di correzione:  versione;esercizio;quesito;risposta
\iow_new:N \g__ft_key_iow
\bool_new:N \g__ft_key_open_bool
\cs_new_protected:Npn \__ft_key_write:n #1
  {
    \bool_if:NF \g__ft_key_open_bool
      {
        \iow_open:Nn \g__ft_key_iow { \c_sys_jobname_str .key.csv }
        \iow_now:Nn \g__ft_key_iow { versione;esercizio;quesito;risposta }
        \bool_gset_true:N \g__ft_key_open_bool
      }
    \iow_now:Nx \g__ft_key_iow
      {
        \int_use:N \g__ft_version_int ;
        \bool_if:NTF \g__ft_ex_bonus_bool { B } { \int_use:N \g__ft_ex_int } ;
        \bool_if:NT \g__ft_inparts_bool { \alph{ftpart} } ;
        #1
      }
  }

% "[opzioni] testo" -> opzioni, testo
\cs_new_protected:Npn \__ft_parse_opt:w [ #1 ] #2 \q_stop
  {
    \keys_set:nn { fancytests / choice } {#1}
    \tl_set:Nn \l__ft_ch_item_tl {#2}
  }

% valuta  if={nome=valore}
\cs_new_protected:Npn \__ft_eval_if:w #1 = #2 \q_stop
  {
    \int_if_exist:cTF { g__ft_pick_ \tl_trim_spaces:n {#1} _int }
      {
        \int_compare:nNnTF { \int_use:c { g__ft_pick_ \tl_trim_spaces:n {#1} _int } } = {#2}
          { \bool_set_true:N \l__ft_ch_iscorrect_bool }
          { \bool_set_false:N \l__ft_ch_iscorrect_bool }
      }
      { \msg_error:nnn { fancytests } { unknown-pick } {#1} }
  }
\msg_new:nnn { fancytests } { unknown-pick } { \pick[#1]{...}~non~definito. }

\cs_new_protected:Npn \__ft_marker:nn #1#2  % #1 indice (1..n), #2 corretta?
  {
    \str_if_eq:VnTF \l__ft_ch_labels_tl { letters }
      {
        \bool_lazy_and:nnTF { #2 } { \legacy_if_p:n { ft@answers } }
          { \textcolor{SubjectColor}{ \textbf { \int_to_Alph:n {#1} ) } } }
          { \textbf { \int_to_Alph:n {#1} ) } }
      }
      {
        \bool_lazy_and:nnTF { #2 } { \legacy_if_p:n { ft@answers } }
          { \textcolor{SubjectColor}{$\blacksquare$} }
          { $\square$ }
      }
  }

\cs_new_protected:Npn \__ft_choices:nn #1#2
  {
    \group_begin:
    \tl_set:Nn \l__ft_ch_cols_tl { auto }
    \bool_set_eq:NN \l__ft_ch_shuffle_bool \g__ft_shuffle_bool
    \bool_if:NTF \g__ft_inparts_bool
      { \dim_set:Nn \l__ft_ch_indent_dim { 0pt } }
      { \dim_set:Nn \l__ft_ch_indent_dim { \itmindent } }
    \tl_set_eq:NN \l__ft_ch_labels_tl \ft@labels
    \dim_set:Nn \l__ft_ch_after_dim { .25em }
    \dim_set:Nn \l__ft_ch_before_dim { 2pt }
    \dim_zero:N \l__ft_ch_rowsep_dim
    \keys_set:nn { fancytests / choices } {#1}
    % --- 1. separa le opzioni ------------------------------------------------
    \tl_set:Nn \l__ft_ch_body_tl {#2}
    \tl_replace_all:Nnn \l__ft_ch_body_tl { \correct } { \choice \__ft_correct_mark: }
    \exp_args:NNnV \seq_set_split_keep_spaces:Nnn \l__ft_ch_raw_seq { \choice } \l__ft_ch_body_tl
    \seq_pop_left:NN \l__ft_ch_raw_seq \l_tmpa_tl          % testo prima di \choice
    \seq_clear:N \l__ft_ch_text_seq
    \seq_clear:N \l__ft_ch_fixed_seq
    \seq_clear:N \l__ft_ch_correct_seq
    \seq_map_inline:Nn \l__ft_ch_raw_seq
      {
        \tl_set:Nn \l__ft_ch_item_tl {##1}
        \bool_set_false:N \l__ft_ch_iscorrect_bool
        \bool_set_false:N \l__ft_c_fixed_bool
        \tl_clear:N \l__ft_c_if_tl
        \exp_args:NV \tl_if_head_eq_meaning:nNT \l__ft_ch_item_tl \__ft_correct_mark:
          {
            \bool_set_true:N \l__ft_ch_iscorrect_bool
            \tl_set:Nx \l__ft_ch_item_tl { \tl_tail:N \l__ft_ch_item_tl }
          }
        \tl_trim_spaces:N \l__ft_ch_item_tl
        \exp_args:NV \tl_if_head_eq_charcode:nNT \l__ft_ch_item_tl [
          {
            \exp_last_unbraced:NV \__ft_parse_opt:w \l__ft_ch_item_tl \q_stop
            \tl_trim_spaces:N \l__ft_ch_item_tl
          }
        \tl_if_empty:NF \l__ft_c_if_tl
          { \exp_last_unbraced:NV \__ft_eval_if:w \l__ft_c_if_tl \q_stop }
        \seq_put_right:NV \l__ft_ch_text_seq \l__ft_ch_item_tl
        \seq_put_right:Nx \l__ft_ch_fixed_seq { \bool_to_str:N \l__ft_c_fixed_bool }
        \seq_put_right:Nx \l__ft_ch_correct_seq { \bool_to_str:N \l__ft_ch_iscorrect_bool }
      }
    \int_set:Nn \l__ft_ch_n_int { \seq_count:N \l__ft_ch_text_seq }
    % --- 2. ordine: mescola le opzioni non fisse ------------------------------
    \seq_clear:N \l__ft_ch_pool_seq
    \int_step_inline:nn { \l__ft_ch_n_int }
      {
        \str_if_eq:eeF { \seq_item:Nn \l__ft_ch_fixed_seq {##1} } { true }
          { \seq_put_right:Nn \l__ft_ch_pool_seq {##1} }
      }
    \bool_if:NT \l__ft_ch_shuffle_bool { \seq_shuffle:N \l__ft_ch_pool_seq }
    \seq_clear:N \l__ft_ch_order_seq
    \int_step_inline:nn { \l__ft_ch_n_int }
      {
        \str_if_eq:eeTF { \seq_item:Nn \l__ft_ch_fixed_seq {##1} } { true }
          { \seq_put_right:Nn \l__ft_ch_order_seq {##1} }
          {
            \seq_pop_left:NN \l__ft_ch_pool_seq \l_tmpa_tl
            \seq_put_right:NV \l__ft_ch_order_seq \l_tmpa_tl
          }
      }
    % --- 3. chiave di correzione ---------------------------------------------
    \tl_clear:N \l__ft_ch_key_tl
    \int_zero:N \l__ft_ch_k_int
    \seq_map_inline:Nn \l__ft_ch_order_seq
      {
        \int_incr:N \l__ft_ch_k_int
        \str_if_eq:eeT { \seq_item:Nn \l__ft_ch_correct_seq {##1} } { true }
          { \tl_put_right:Nx \l__ft_ch_key_tl { \int_to_Alph:n { \l__ft_ch_k_int } } }
      }
    \tl_if_empty:NF \l__ft_ch_key_tl { \__ft_key_write:n { \l__ft_ch_key_tl } }
    % --- 4. misure e numero di colonne ---------------------------------------
    \hbox_set:Nn \l__ft_ch_tmp_box { \__ft_marker:nn { 1 } { \c_false_bool } \hspace{.75em} }
    \dim_set:Nn \l__ft_ch_mark_dim { \box_wd:N \l__ft_ch_tmp_box }
    \dim_set:Nn \l__ft_ch_gap_dim { 1em }
    \dim_zero:N \l__ft_ch_max_dim
    \int_zero:N \l__ft_ch_k_int
    \seq_map_inline:Nn \l__ft_ch_order_seq
      {
        \int_incr:N \l__ft_ch_k_int
        \box_if_exist:cF { l__ft_ch_ \int_use:N \l__ft_ch_k_int _box }
          { \box_new:c { l__ft_ch_ \int_use:N \l__ft_ch_k_int _box } }
        \hbox_set:cn { l__ft_ch_ \int_use:N \l__ft_ch_k_int _box }
          { \seq_item:Nn \l__ft_ch_text_seq {##1} }
        \dim_set:Nn \l__ft_ch_max_dim
          { \dim_max:nn { \l__ft_ch_max_dim }
                        { \box_wd:c { l__ft_ch_ \int_use:N \l__ft_ch_k_int _box } } }
      }
    \str_if_eq:VnTF \l__ft_ch_cols_tl { auto }
      {
        % tutte su una riga, altrimenti due colonne, altrimenti una
        \int_set:Nn \l__ft_ch_cols_int { 1 }
        \clist_map_inline:nn { \int_min:nn { \l__ft_ch_n_int } { 5 } , 2 }
          {
            \bool_lazy_and:nnT
              { \int_compare_p:nNn { \l__ft_ch_cols_int } = 1 }
              { \int_compare_p:nNn {##1} > 1 }
              {
                \dim_compare:nNnT
                  { \l__ft_ch_max_dim + \l__ft_ch_mark_dim }
                  <
                  { ( \linewidth - \l__ft_ch_indent_dim - \l__ft_ch_gap_dim * ( ##1 - 1 ) ) / ##1 }
                  { \int_set:Nn \l__ft_ch_cols_int {##1} }
              }
          }
      }
      { \int_set:Nn \l__ft_ch_cols_int { \l__ft_ch_cols_tl } }
    \dim_set:Nn \l__ft_ch_w_dim
      { ( \linewidth - \l__ft_ch_indent_dim - \l__ft_ch_gap_dim * ( \l__ft_ch_cols_int - 1 ) )
        / \l__ft_ch_cols_int - 1pt }
    % --- 5. composizione -----------------------------------------------------
    \par \nobreak \bool_if:NF \l__ft_ch_openend_bool { \vspace { \l__ft_ch_before_dim } }
    \everypar { }          % niente strut automatico dentro le celle p{} di tabelle
    \parskip = 0pt \relax
    \lineskip = 3pt \relax
    \int_zero:N \l__ft_ch_k_int
    \seq_map_inline:Nn \l__ft_ch_order_seq
      {
        \int_incr:N \l__ft_ch_k_int
        \int_compare:nNnT { \int_mod:nn { \l__ft_ch_k_int - 1 } { \l__ft_ch_cols_int } } = 0
          {
            \int_compare:nNnF \l__ft_ch_k_int = 1 { \par \vspace { \l__ft_ch_rowsep_dim } }
            \noindent \hspace* { \l__ft_ch_indent_dim }
          }
        \int_compare:nNnF { \int_mod:nn { \l__ft_ch_k_int - 1 } { \l__ft_ch_cols_int } } = 0
          { \nobreak \hspace { \l__ft_ch_gap_dim } }
        \bool_set:Nn \l__ft_ch_iscorrect_bool
          { \str_if_eq_p:ee { \seq_item:Nn \l__ft_ch_correct_seq {##1} } { true } }
        \dim_compare:nNnTF
          { \box_wd:c { l__ft_ch_ \int_use:N \l__ft_ch_k_int _box } + \l__ft_ch_mark_dim }
          > { \l__ft_ch_w_dim }
          {
            % opzione lunga: va a capo con rientro sospeso
            \parbox [t] { \l__ft_ch_w_dim }
              {
                \hangindent = \l__ft_ch_mark_dim \hangafter = 1 \relax
                \makebox [ \l__ft_ch_mark_dim ] [l]
                  { \__ft_marker:nn { \l__ft_ch_k_int } { \l__ft_ch_iscorrect_bool } }
                \seq_item:Nn \l__ft_ch_text_seq {##1}
              }
          }
          {
            \makebox [ \l__ft_ch_w_dim ] [l]
              {
                \makebox [ \l__ft_ch_mark_dim ] [l]
                  { \__ft_marker:nn { \l__ft_ch_k_int } { \l__ft_ch_iscorrect_bool } }
                \box_use:c { l__ft_ch_ \int_use:N \l__ft_ch_k_int _box }
              }
          }
      }
    \bool_if:NTF \l__ft_ch_openend_bool
      { \vspace { \l__ft_ch_after_dim } }    % resta in modo orizzontale (celle di tabella)
      { \par \vspace { \l__ft_ch_after_dim } }
    \group_end:
  }
\bool_new:N \l__ft_ch_openend_bool
\cs_generate_variant:Nn \__ft_choices:nn { nV }

\NewDocumentEnvironment { choices } { O{} +b } { \__ft_choices:nn {#1} {#2} } { }
